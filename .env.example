# ---- Neon (server only — never exposed to the browser) ----
# Neon dashboard → your project → Connect → copy the "postgresql://..." URI.
# The pooled host (ends with -pooler) is the right choice for this app.
DATABASE_URL=

# ---- API process ----
API_PORT=8787

# ---- Vite dev server ----
# 3001 by default so it does not collide with other local servers on 3000.

# ---- Not wired up yet (see OVERVIEW.md) ----
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
